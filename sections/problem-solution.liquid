<section class="section-padding problem-solution-section" aria-label="Problem and Solution">
  <div class="container">
    <div class="section-header">
      <span class="section-tag"><i class="fa-solid fa-scale-balanced"></i> THE HOROLOGY DILEMMA</span>
      <h2>The Flaw in Traditional Luxury <span class="gold-text">And Our Solution</span></h2>
      <p>For decades, traditional luxury watchmakers charged massive 10x-20x middleman markups while department store fashion brands sold cheap, fragile quartz pieces.</p>
    </div>

    <div class="problem-solution-grid">
      <!-- Problem Card -->
      <div class="problem-card">
        <span class="card-badge problem"><i class="fa-solid fa-triangle-exclamation"></i> The Traditional Trap</span>
        <h3>Why Most Watches Disappoint</h3>
        <div class="problem-list">
          <div class="point-item">
            <i class="fa-solid fa-circle-xmark"></i>
            <div>
              <h5>Inflated 1500% Middleman Markups</h5>
              <p>Paying thousands of dollars for brand logos, storefront rent, and celebrity sponsorships rather than actual watchmaking quality.</p>
            </div>
          </div>
          <div class="point-item">
            <i class="fa-solid fa-circle-xmark"></i>
            <div>
              <h5>Fragile Mineral Glass Scratches Easily</h5>
              <p>Cheap fashion watches use mineral or acrylic glass that scratches from simple door knobs, keys, and everyday friction.</p>
            </div>
          </div>
          <div class="point-item">
            <i class="fa-solid fa-circle-xmark"></i>
            <div>
              <h5>Dead Batteries & Soulless Quartz</h5>
              <p>Constant battery replacements every year with no mechanical heartbeat or sweeping seconds hand.</p>
            </div>
          </div>
          <div class="point-item">
            <i class="fa-solid fa-circle-xmark"></i>
            <div>
              <h5>Fake Water Resistance Ratings</h5>
              <p>Weak push-pull gaskets that fog up and ruin internal movements at the first splash of rain or shower.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Solution Card -->
      <div class="solution-card">
        <span class="card-badge solution"><i class="fa-solid fa-circle-check"></i> The AURA Standard</span>
        <h3>Precision Craftsmanship Without Compromise</h3>
        <div class="solution-list">
          <div class="point-item">
            <i class="fa-solid fa-circle-check"></i>
            <div>
              <h5>Direct Atelier Value</h5>
              <p>Hand-finished 316L stainless steel, ceramic bezels, and automatic calibers delivered directly to collectors worldwide at transparent prices.</p>
            </div>
          </div>
          <div class="point-item">
            <i class="fa-solid fa-circle-check"></i>
            <div>
              <h5>Synthetic Sapphire Crystal (9 Mohs Hardness)</h5>
              <p>Second only to diamond in hardness. Completely scratch-proof with anti-reflective optical clarity under direct sunlight.</p>
            </div>
          </div>
          <div class="point-item">
            <i class="fa-solid fa-circle-check"></i>
            <div>
              <h5>Autonomous Mechanical Calibers</h5>
              <p>Seiko NH35A and Geneva tourbillon calibers. Powered perpetually by the natural kinetic motion of your daily life.</p>
            </div>
          </div>
          <div class="point-item">
            <i class="fa-solid fa-circle-check"></i>
            <div>
              <h5>Tested 100M-915M Water Armor</h5>
              <p>Threaded screw-down triple-gasket crowns and helium escape valves engineered for real aquatic endurance.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

