<section class="section-padding whats-included-section" aria-label="What is Included">
  <div class="container">
    <div class="section-header">
      <span class="section-tag"><i class="fa-solid fa-box-open"></i> UNBOXING EXPERIENCE</span>
      <h2>Everything Inside the <span class="gold-text">Luxury Presentation Vault</span></h2>
      <p>A collector-grade presentation box designed to protect and honor your acquisition for generations.</p>
    </div>

    <div class="included-layout">
      <div class="included-image">
        <img src="assets/images/craftsmanship_atelier.jpg" alt="AURA Horology Luxury Presentation Box" loading="lazy">
      </div>

      <div class="included-list">
        <div class="included-item">
          <i class="fa-solid fa-clock"></i>
          <div>
            <h5>Your Serialized Masterpiece</h5>
            <p>Individually inspected watch protected by anti-scratch protective film and serialized laser-etched caseback.</p>
          </div>
        </div>

        <div class="included-item">
          <i class="fa-solid fa-gem"></i>
          <div>
            <h5>Piano-Black Lacquer Hardwood Box</h5>
            <p>Plush cream suede velvet interior with molded watch cushion and gold-plated brass hinges.</p>
          </div>
        </div>

        <div class="included-item">
          <i class="fa-solid fa-file-shield"></i>
          <div>
            <h5>Official Certificate of Origin</h5>
            <p>Embossed authenticity certificate signed by our master horologist with timing report.</p>
          </div>
        </div>

        <div class="included-item">
          <i class="fa-solid fa-id-card"></i>
          <div>
            <h5>5-Year International Warranty Card</h5>
            <p>Engraved brushed stainless steel warranty card registered in our global collector database.</p>
          </div>
        </div>

        <div class="included-item">
          <i class="fa-solid fa-screwdriver-wrench"></i>
          <div>
            <h5>Precision Link Sizing Tool & Cloth</h5>
            <p>Solid brass bracelet pin remover tool and ultra-fine microfiber polishing cloth.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Whats Included",
  "settings": [],
  "presets": [
    {
      "name": "Whats Included"
    }
  ]
}
{% endschema %}
