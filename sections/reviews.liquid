<section id="reviewsSection" class="section-padding reviews-section" aria-label="Collector Testimonials">
  <div class="container">
    <div class="section-header">
      <span class="section-tag"><i class="fa-solid fa-star"></i> REVIEWS & FEEDBACK</span>
      <h2>Acclaimed by <span class="gold-text">Horology Enthusiasts</span></h2>
      <p>Rated 4.9/5 by over 2,840+ collectors and watch enthusiasts worldwide.</p>
    </div>

    <div class="reviews-grid">
      <!-- Review 1 -->
      <div class="review-card">
        <div class="review-rating">
          <i class="fa-solid fa-star"></i>
          <i class="fa-solid fa-star"></i>
          <i class="fa-solid fa-star"></i>
          <i class="fa-solid fa-star"></i>
          <i class="fa-solid fa-star"></i>
        </div>
        <h4 class="review-title">"Unrivaled Automatic Movement & Ceramic Bezel"</h4>
        <p class="review-comment">
          "I have collected Swiss watches for over 15 years. The Pagani Classic Dive exceeded all expectations. The Seiko NH35 caliber runs at +3 seconds/day, the ceramic bezel has zero backplay, and the sapphire crystal is flawless. Outstanding quality."
        </p>
        <div class="reviewer-meta">
          <div class="reviewer-avatar">MS</div>
          <div class="reviewer-info">
            <h5>Marcus Sterling <i class="fa-solid fa-circle-check verified-badge" title="Verified Collector"></i></h5>
            <p>Verified Buyer &bull; Pagani Dive Style 100M</p>
          </div>
        </div>
      </div>

      <!-- Review 2 -->
      <div class="review-card">
        <div class="review-rating">
          <i class="fa-solid fa-star"></i>
          <i class="fa-solid fa-star"></i>
          <i class="fa-solid fa-star"></i>
          <i class="fa-solid fa-star"></i>
          <i class="fa-solid fa-star"></i>
        </div>
        <h4 class="review-title">"The Blue Sunburst Chronograph is a Showstopper"</h4>
        <p class="review-comment">
          "The Benyar Chronograph catches light in the most extraordinary way. Every subdial functions with tactile precision. The rose gold case and silicone strap make it comfortable enough to wear all day in the office."
        </p>
        <div class="reviewer-meta">
          <div class="reviewer-avatar">HV</div>
          <div class="reviewer-info">
            <h5>Lord Harrison Vance <i class="fa-solid fa-circle-check verified-badge" title="Verified Collector"></i></h5>
            <p>Verified Buyer &bull; Benyar Lifestyle Chrono</p>
          </div>
        </div>
      </div>

      <!-- Review 3 -->
      <div class="review-card">
        <div class="review-rating">
          <i class="fa-solid fa-star"></i>
          <i class="fa-solid fa-star"></i>
          <i class="fa-solid fa-star"></i>
          <i class="fa-solid fa-star"></i>
          <i class="fa-solid fa-star"></i>
        </div>
        <h4 class="review-title">"Rugged Tactical Beast with Shock Armor"</h4>
        <p class="review-comment">
          "Wore the Naviforce Tactical Sport through a week-long backcountry expedition. Heavy rain, rocky trails, dust—it handled everything without a hitch. The dual digital-analog display is brilliant for low-light survival."
        </p>
        <div class="reviewer-meta">
          <div class="reviewer-avatar">JD</div>
          <div class="reviewer-info">
            <h5>Julian De Vries <i class="fa-solid fa-circle-check verified-badge" title="Verified Collector"></i></h5>
            <p>Verified Buyer &bull; Naviforce Military Sport</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Reviews Section",
  "settings": [],
  "presets": [
    {
      "name": "Reviews Section"
    }
  ]
}
{% endschema %}
