<footer id="footerSection" class="site-footer" role="contentinfo">
  <div class="container">
    <div class="footer-grid">
      <!-- Brand Column -->
      <div class="footer-brand">
        <a href="/" class="header-logo" style="margin-bottom: 12px;">
          <div class="logo-crown"><i class="fa-solid fa-crown"></i></div>
          <div class="logo-text">
            <span class="logo-brand">AURA</span>
            <span class="logo-tag">HAUTE HORLOGERIE</span>
          </div>
        </a>
        <p>
          Precision automatic mechanical timepieces engineered with sapphire crystals, ceramic bezels, and Japanese/Swiss calibers for discerning collectors worldwide.
        </p>
        <div class="footer-socials">
          <a href="https://instagram.com" target="_blank" rel="noopener" class="footer-social-link" aria-label="Instagram"><i class="fa-brands fa-instagram"></i></a>
          <a href="https://facebook.com" target="_blank" rel="noopener" class="footer-social-link" aria-label="Facebook"><i class="fa-brands fa-facebook-f"></i></a>
          <a href="https://youtube.com" target="_blank" rel="noopener" class="footer-social-link" aria-label="YouTube"><i class="fa-brands fa-youtube"></i></a>
          <a href="https://wa.me/18005550199" target="_blank" rel="noopener" class="footer-social-link" aria-label="WhatsApp Concierge"><i class="fa-brands fa-whatsapp"></i></a>
        </div>
      </div>

      <!-- Column 1: Shop -->
      <div class="footer-col">
        <h5>SHOP</h5>
        <div class="footer-links">
          <a href="#catalogSection">Automatic Dive Watches</a>
          <a href="#catalogSection">Luxury Chronographs</a>
          <a href="#catalogSection">Tactical Military Sport</a>
          <a href="#catalogSection">Skeleton Tourbillon</a>
          <a href="#catalogSection">Collector Bundles</a>
        </div>
      </div>

      <!-- Column 2: Client Care -->
      <div class="footer-col">
        <h5>CLIENT CARE</h5>
        <div class="footer-links">
          <a href="#faqSection">Frequently Asked Questions</a>
          <a href="javascript:void(0)" onclick="AuraStore.openModal('checkoutModalOverlay')">Track Insured Order</a>
          <a href="pages/shipping-policy.html">Shipping & Delivery</a>
          <a href="pages/refund-policy.html">Returns & Exchanges</a>
          <a href="#guaranteeSection">5-Year Warranty Claim</a>
        </div>
      </div>

      <!-- Column 3: Company -->
      <div class="footer-col">
        <h5>THE ATELIER</h5>
        <div class="footer-links">
          <a href="pages/about.html">Our Horology Heritage</a>
          <a href="pages/why-us.html">Why Choose AURA</a>
          <a href="#reviewsSection">Verified Collector Reviews</a>
          <a href="pages/contact.html">Boutique Appointment</a>
          <a href="pages/contact.html">Press & Media</a>
        </div>
      </div>

      <!-- Column 4: Legal & Policies -->
      <div class="footer-col">
        <h5>LEGAL</h5>
        <div class="footer-links">
          <a href="pages/privacy-policy.html">Privacy Policy</a>
          <a href="pages/terms.html">Terms of Service</a>
          <a href="pages/refund-policy.html">Refund Policy</a>
          <a href="pages/shipping-policy.html">Shipping Policy</a>
          <a href="javascript:void(0)">Certificate Verification</a>
        </div>
      </div>
    </div>

    <!-- Footer Bottom -->
    <div class="footer-bottom">
      <div>
        &copy; {{ 'now' | date: '%Y' }} AURA TIMEPIECES &bull; Haute Horlogerie Atelier. All Rights Reserved.
      </div>
      <div class="payment-icons">
        <i class="fa-brands fa-cc-visa" title="Visa"></i>
        <i class="fa-brands fa-cc-mastercard" title="Mastercard"></i>
        <i class="fa-brands fa-cc-amex" title="Amex"></i>
        <i class="fa-brands fa-cc-apple-pay" title="Apple Pay"></i>
        <i class="fa-brands fa-shopify" title="Shopify Pay"></i>
        <i class="fa-solid fa-truck-fast" title="Cash on Delivery Available"></i>
      </div>
    </div>
  </div>
</footer>

