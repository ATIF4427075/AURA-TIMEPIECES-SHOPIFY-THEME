<section class="section-padding feature-grid-section" aria-label="Engineered Horology Features">
  <div class="container">
    <div class="section-header">
      <span class="section-tag"><i class="fa-solid fa-microchip"></i> AUTHENTIC FEATURES</span>
      <h2>Engineered for Adventure, <span class="gold-text">Built to Last</span></h2>
      <p>Every feature verified from our original Pagani Design, Benyar, and Naviforce timepieces.</p>
    </div>

    <div class="features-six-grid">
      <!-- Feature 1 -->
      <div class="feature-box">
        <div class="feature-icon-wrap">
          <i class="fa-solid fa-gears"></i>
        </div>
        <h4>Automatic Movement</h4>
        <p>Kinetic self-winding Japanese Seiko NH35A movement with 41-hour power reserve. No batteries needed ever.</p>
      </div>

      <!-- Feature 2 -->
      <div class="feature-box">
        <div class="feature-icon-wrap">
          <i class="fa-solid fa-gem"></i>
        </div>
        <h4>Synthetic Sapphire Crystal</h4>
        <p>9 Mohs hardness scratch-proof sapphire crystal lens with anti-reflective coating for crystal clear dial visibility.</p>
      </div>

      <!-- Feature 3 -->
      <div class="feature-box">
        <div class="feature-icon-wrap">
          <i class="fa-solid fa-water"></i>
        </div>
        <h4>100M Water Resistance</h4>
        <p>Hermetic screw-down crown and threaded caseback. Safe for swimming, showering, and water sports.</p>
      </div>

      <!-- Feature 4 -->
      <div class="feature-box">
        <div class="feature-icon-wrap">
          <i class="fa-solid fa-stopwatch"></i>
        </div>
        <h4>Chronograph & Tachymeter</h4>
        <p>Precision Japanese quartz chronograph with split-second sub-dials and fixed 400-unit speed tachymeter bezel.</p>
      </div>

      <!-- Feature 5 -->
      <div class="feature-box">
        <div class="feature-icon-wrap">
          <i class="fa-solid fa-sun"></i>
        </div>
        <h4>Super-LumiNova & Dual LCD</h4>
        <p>High-glow phosphorescent hands paired with back-lit digital LCD screens for zero-light tactical visibility.</p>
      </div>

      <!-- Feature 6 -->
      <div class="feature-box">
        <div class="feature-icon-wrap">
          <i class="fa-solid fa-shield-halved"></i>
        </div>
        <h4>316L Solid Steel & Suede Leather</h4>
        <p>Corrosion-resistant marine 316L stainless steel oyster bracelet and genuine breathable suede leather straps.</p>
      </div>
    </div>
  </div>
</section>

