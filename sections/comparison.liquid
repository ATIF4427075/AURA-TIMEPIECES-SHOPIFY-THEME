<section class="section-padding comparison-section" aria-label="Horology Comparison">
  <div class="container">
    <div class="section-header">
      <span class="section-tag"><i class="fa-solid fa-code-compare"></i> HOROLOGY MATRIX</span>
      <h2>Factual Comparison: <span class="gold-text">AURA vs The Market</span></h2>
      <p>Transparent specifications compared directly against department store watches and heritage retail brands.</p>
    </div>

    <div class="comparison-table-wrap">
      <table class="comparison-table">
        <thead>
          <tr>
            <th>Specification</th>
            <th class="highlight-col">AURA & PAGANI DESIGN</th>
            <th>Mall Fashion Brands</th>
            <th>Traditional Heritage Luxury</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><strong>Movement Type</strong></td>
            <td class="highlight-col"><i class="fa-solid fa-check" style="color: var(--color-emerald);"></i> Japanese Seiko NH35A / Auto Caliber</td>
            <td><i class="fa-solid fa-xmark" style="color: #ef4444;"></i> Cheap Generic Quartz</td>
            <td><i class="fa-solid fa-check" style="color: var(--color-emerald);"></i> In-House Automatic</td>
          </tr>
          <tr>
            <td><strong>Crystal Lens</strong></td>
            <td class="highlight-col"><i class="fa-solid fa-check" style="color: var(--color-emerald);"></i> Synthetic Sapphire (9 Mohs)</td>
            <td><i class="fa-solid fa-xmark" style="color: #ef4444;"></i> Fragile Mineral Glass</td>
            <td><i class="fa-solid fa-check" style="color: var(--color-emerald);"></i> Sapphire Glass</td>
          </tr>
          <tr>
            <td><strong>Water Resistance</strong></td>
            <td class="highlight-col"><i class="fa-solid fa-check" style="color: var(--color-emerald);"></i> 100M-915M Screw-Down Sealed</td>
            <td><i class="fa-solid fa-xmark" style="color: #ef4444;"></i> 30M Splash only</td>
            <td><i class="fa-solid fa-check" style="color: var(--color-emerald);"></i> 100M-300M</td>
          </tr>
          <tr>
            <td><strong>Bezel Material</strong></td>
            <td class="highlight-col"><i class="fa-solid fa-check" style="color: var(--color-emerald);"></i> Sintered Scratch-Proof Ceramic</td>
            <td><i class="fa-solid fa-xmark" style="color: #ef4444;"></i> Painted Aluminum / Plastic</td>
            <td><i class="fa-solid fa-check" style="color: var(--color-emerald);"></i> Ceramic / Gold</td>
          </tr>
          <tr>
            <td><strong>Warranty Coverage</strong></td>
            <td class="highlight-col"><i class="fa-solid fa-check" style="color: var(--color-emerald);"></i> 5-Year Global Movement Warranty</td>
            <td><i class="fa-solid fa-xmark" style="color: #ef4444;"></i> 1-Year Limited</td>
            <td><i class="fa-solid fa-check" style="color: var(--color-emerald);"></i> 2 to 5 Years</td>
          </tr>
          <tr>
            <td><strong>Fair Price Range</strong></td>
            <td class="highlight-col"><strong>₨ 14,900 – ₨ 28,500</strong></td>
            <td>₨ 25,000 – ₨ 50,000 (Overpriced)</td>
            <td>₨ 1,200,000 – ₨ 5,000,000+</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Comparison Table",
  "settings": [],
  "presets": [
    {
      "name": "Comparison Table"
    }
  ]
}
{% endschema %}
