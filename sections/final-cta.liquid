<section class="final-cta-section" aria-label="Final Call to Action">
  <div class="container">
    <div style="max-width: 720px; margin: 0 auto; text-align: center;">
      <div class="logo-crown" style="font-size: 2.4rem; margin-bottom: 12px;"><i class="fa-solid fa-crown"></i></div>
      <h2 style="margin-bottom: 16px;">Elevate Your Wrist. <br><span class="gold-text">Claim Your Masterpiece Today.</span></h2>
      <p style="color: var(--color-text-secondary); font-size: 1.1rem; line-height: 1.7; margin-bottom: 36px;">
        Join over 2,840+ discerning gentlemen who have discovered precision automatic horology without arbitrary luxury markups. 5-Year Warranty & Complimentary Insured Courier included.
      </p>
      <div style="display: flex; justify-content: center; gap: 16px; flex-wrap: wrap;">
        <button class="btn btn-primary" onclick="AuraStore.addToCart('pagani-classic-dive', 1)">
          <i class="fa-solid fa-bag-shopping"></i> Order Classic Dive &bull; ₨ 28,500
        </button>
        <a href="#catalogSection" class="btn btn-secondary">
          <i class="fa-solid fa-compass"></i> Explore All Collections
        </a>
      </div>
    </div>
  </div>
</section>

