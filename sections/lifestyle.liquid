<section id="lifestyleSection" class="section-padding lifestyle-section" aria-label="Lifestyle Moments">
  <div class="container">
    <div class="section-header">
      <span class="section-tag"><i class="fa-solid fa-camera"></i> REAL-LIFE STYLE</span>
      <h2>Perfect for <span class="gold-text">Every Occasion</span></h2>
      <p>From high-stakes boardroom deals to extreme outdoor expeditions.</p>
    </div>

    <div class="lifestyle-bento">
      <!-- Large Bento: Benyar Poster -->
      <div class="bento-card bento-large">
        <img src="{{ 'benyar_lifestyle_poster.jpg' | asset_url }}" alt="Benyar It's a Lifestyle Chronograph" loading="lazy">
        <div class="bento-overlay">
          <h4>Executive Lifestyle</h4>
          <p>Benyar Classic Bold Timeless &bull; Perfect for Work, Dates & Everyday.</p>
        </div>
      </div>

      <!-- Bento 2: Pagani Dive Poster -->
      <div class="bento-card">
        <img src="{{ 'pagani_dive_poster.jpg' | asset_url }}" alt="Pagani Classic Dive Style 100M" loading="lazy">
        <div class="bento-overlay">
          <h4>Maritime Dive Style</h4>
          <p>Seiko NH35A Automatic &bull; 100M Waterproof.</p>
        </div>
      </div>

      <!-- Bento 3: Naviforce Tactical Poster -->
      <div class="bento-card">
        <img src="{{ 'naviforce_military_poster.jpg' | asset_url }}" alt="Naviforce Tactical Sport" loading="lazy">
        <div class="bento-overlay">
          <h4>Tactical Endurance</h4>
          <p>Built for Real Men &bull; Adventure Awaits.</p>
        </div>
      </div>

      <!-- Bento 4: Pagani Macro View -->
      <div class="bento-card">
        <img src="{{ 'pagani_dive_macro.jpg' | asset_url }}" alt="Pagani Dial Macro" loading="lazy">
        <div class="bento-overlay">
          <h4>Sapphire Glass & Ceramic</h4>
          <p>Scratch-proof crystal and gold accents.</p>
        </div>
      </div>

      <!-- Bento 5: Lume Glow View -->
      <div class="bento-card">
        <img src="{{ 'lume_night_glow.jpg' | asset_url }}" alt="Night Luminescence" loading="lazy">
        <div class="bento-overlay">
          <h4>Luminous Night Vision</h4>
          <p>Super-LumiNova vivid phosphorescent hands.</p>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Lifestyle Showcase",
  "settings": [],
  "presets": [
    {
      "name": "Lifestyle Showcase"
    }
  ]
}
{% endschema %}
