<section id="coreFeaturesSection" class="section-padding core-features-section" aria-label="Core Horology Pillars">
  <div class="container">
    <div class="section-header">
      <span class="section-tag"><i class="fa-solid fa-gem"></i> THE THREE PILLARS</span>
      <h2>Engineered to <span class="gold-text">Outperform</span></h2>
      <p>Every timepiece in our collections is constructed with zero compromise on materials, movement accuracy, or finishing.</p>
    </div>

    <div class="core-pillars-grid">
      <!-- Pillar 1: Movement -->
      <div class="pillar-card">
        <div class="pillar-icon-box">
          <i class="fa-solid fa-gears"></i>
        </div>
        <h3>Automatic Movement</h3>
        <p>Kinetic self-winding mechanical calibers oscillating at 21,600 to 28,800 vibrations per hour. No batteries, no electronic waste—just pure mechanical mastery.</p>
      </div>

      <!-- Pillar 2: Water Resistance -->
      <div class="pillar-card">
        <div class="pillar-icon-box">
          <i class="fa-solid fa-droplet"></i>
        </div>
        <h3>100M-915M Water Armor</h3>
        <p>Hermetically sealed cases with threaded screw-down crowns and O-ring synthetic gaskets. Tested under pressure for swimming, showering, and ocean diving.</p>
      </div>

      <!-- Pillar 3: Sapphire Crystal -->
      <div class="pillar-card">
        <div class="pillar-icon-box">
          <i class="fa-solid fa-gem"></i>
        </div>
        <h3>Sapphire & Ceramic</h3>
        <p>Ultra-dense synthetic sapphire crystal glass with anti-reflective coating paired with a 120-click high-tech ceramic scratch-resistant bezel.</p>
      </div>
    </div>
  </div>
</section>

