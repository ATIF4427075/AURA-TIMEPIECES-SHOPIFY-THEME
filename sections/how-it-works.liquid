<section id="howItWorksSection" class="section-padding how-it-works-section" aria-label="White-Glove Process">
  <div class="container">
    <div class="section-header">
      <span class="section-tag"><i class="fa-solid fa-route"></i> THE JOURNEY</span>
      <h2>Our White-Glove <span class="gold-text">Acquisition Process</span></h2>
      <p>From atelier workbench calibration to insured delivery at your door.</p>
    </div>

    <div class="steps-grid">
      <!-- Step 01 -->
      <div class="step-card">
        <div class="step-number">01</div>
        <h4>Select Masterpiece</h4>
        <p>Choose from our curated collection of automatic dive, chronograph, or flying tourbillon timepieces.</p>
      </div>

      <!-- Step 02 -->
      <div class="step-card">
        <div class="step-number">02</div>
        <h4>Personalize & Sizing</h4>
        <p>Add optional bespoke caseback laser engraving with your monogram, family crest, or anniversary date.</p>
      </div>

      <!-- Step 03 -->
      <div class="step-card">
        <div class="step-number">03</div>
        <h4>Atelier Timing Check</h4>
        <p>Every watch undergoes 48-hour timegrapher testing to guarantee strict precision accuracy within ±5 sec/day.</p>
      </div>

      <!-- Step 04 -->
      <div class="step-card">
        <div class="step-number">04</div>
        <h4>Insured Dispatch</h4>
        <p>Shipped in our luxury lacquer presentation vault with Certificate of Origin, warranty card, and sizing tool.</p>
      </div>
    </div>
  </div>
</section>

