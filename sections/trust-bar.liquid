<section class="trust-bar-section" aria-label="Trust & Guarantees">
  <div class="container">
    <div class="trust-grid">
      <div class="trust-card">
        <div class="trust-card-icon">
          <i class="fa-solid fa-truck-fast"></i>
        </div>
        <div class="trust-card-text">
          <h4>Complimentary Shipping</h4>
          <p>Insured express courier delivery worldwide.</p>
        </div>
      </div>

      <div class="trust-card">
        <div class="trust-card-icon">
          <i class="fa-solid fa-shield-halved"></i>
        </div>
        <div class="trust-card-text">
          <h4>5-Year Warranty</h4>
          <p>Comprehensive mechanical movement protection.</p>
        </div>
      </div>

      <div class="trust-card">
        <div class="trust-card-icon">
          <i class="fa-solid fa-rotate-left"></i>
        </div>
        <div class="trust-card-text">
          <h4>30-Day Evaluation</h4>
          <p>Risk-free returns in original condition.</p>
        </div>
      </div>

      <div class="trust-card">
        <div class="trust-card-icon">
          <i class="fa-solid fa-award"></i>
        </div>
        <div class="trust-card-text">
          <h4>Certificate of Origin</h4>
          <p>Individually inspected and serialized.</p>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Trust Bar",
  "settings": [],
  "presets": [
    {
      "name": "Trust Bar"
    }
  ]
}
{% endschema %}
