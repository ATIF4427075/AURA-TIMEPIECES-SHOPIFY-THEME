<section class="section-padding guarantee-section" aria-label="5-Year International Warranty">
  <div class="container">
    <div class="guarantee-box">
      <div class="guarantee-icon">
        <i class="fa-solid fa-shield-halved"></i>
      </div>
      <h2>Our 5-Year Global Warranty <br><span class="gold-text">& 30-Day Risk-Free Guarantee</span></h2>
      <p>
        Every timepiece ordered through AURA TIMEPIECES is backed by our comprehensive 5-year mechanical movement warranty. If your watch exhibits any caliber deviation, manufacturing defect, or gasket compromise, we will repair, regulate, or replace it with priority courier handling at zero expense to you.
      </p>
      <div style="display: flex; justify-content: center; gap: 20px; flex-wrap: wrap;">
        <div class="trust-item-mini">
          <i class="fa-solid fa-circle-check" style="color: var(--color-emerald);"></i>
          <span>100% Genuine Certified Calibers</span>
        </div>
        <div class="trust-item-mini">
          <i class="fa-solid fa-circle-check" style="color: var(--color-emerald);"></i>
          <span>Full Transit Damage Insurance</span>
        </div>
        <div class="trust-item-mini">
          <i class="fa-solid fa-circle-check" style="color: var(--color-emerald);"></i>
          <span>Dedicated Horologist Concierge</span>
        </div>
      </div>
    </div>
  </div>
</section>

