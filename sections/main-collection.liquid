<section class="section-padding" aria-label="Collection Page">
  <div class="container">
    <div class="section-header">
      <span class="section-tag"><i class="fa-solid fa-gem"></i> COLLECTION</span>
      <h1>{{ collection.title | default: 'Horology Timepiece Collections' }}</h1>
      <p>{{ collection.description | default: 'Explore handcrafted automatic, chronograph, and tourbillon masterworks.' }}</p>
    </div>

    <!-- Catalog Filter Bar -->
    <div class="catalog-filter-bar">
      <div class="filter-pills">
        <button class="filter-pill active" data-category="all">All</button>
        <button class="filter-pill" data-category="dive">Automatic Dive</button>
        <button class="filter-pill" data-category="chronograph">Luxury Chronograph</button>
        <button class="filter-pill" data-category="military">Tactical Military</button>
        <button class="filter-pill" data-category="tourbillon">Flying Tourbillon</button>
      </div>
      <div class="sort-select-box">
        <select id="collectionSortSelect">
          <option value="featured">Sort by: Featured</option>
          <option value="price-low">Price: Low to High</option>
          <option value="price-high">Price: High to Low</option>
          <option value="rating">Customer Rating</option>
        </select>
      </div>
    </div>

    <!-- Grid -->
    <div id="catalogProductsGrid" class="catalog-grid">
      <!-- Dynamically filled or liquid loop -->
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Main Collection",
  "settings": []
}
{% endschema %}
