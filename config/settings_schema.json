[
  {
    "name": "theme_info",
    "theme_name": "AURA Haute Horlogerie OS 2.0",
    "theme_author": "AURA Design Studios",
    "theme_version": "2.5.0",
    "theme_documentation_url": "https://auratimepieces.com/docs",
    "theme_support_url": "https://auratimepieces.com/support"
  },
  {
    "name": "Colors & Aesthetics",
    "settings": [
      {
        "type": "color",
        "id": "color_bg",
        "label": "Base Background",
        "default": "#070a11"
      },
      {
        "type": "color",
        "id": "color_surface",
        "label": "Surface / Card Background",
        "default": "#0e1524"
      },
      {
        "type": "color",
        "id": "color_surface_hover",
        "label": "Card Hover Surface",
        "default": "#141e33"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Text Color",
        "default": "#f8fafc"
      },
      {
        "type": "color",
        "id": "color_text_muted",
        "label": "Muted Text Color",
        "default": "#94a3b8"
      },
      {
        "type": "color",
        "id": "color_primary",
        "label": "Primary Accent (Gold)",
        "default": "#d4af37"
      },
      {
        "type": "color",
        "id": "color_primary_hover",
        "label": "Primary Accent Hover",
        "default": "#f59e0b"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Secondary Accent (Emerald / Cyan)",
        "default": "#10b981"
      },
      {
        "type": "color",
        "id": "color_border",
        "label": "Border Color",
        "default": "rgba(255, 255, 255, 0.1)"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "font_heading",
        "label": "Heading Font",
        "default": "playfair_display_n7"
      },
      {
        "type": "font_picker",
        "id": "font_body",
        "label": "Body Font",
        "default": "plus_jakarta_sans_n4"
      },
      {
        "type": "range",
        "id": "body_font_size",
        "min": 14,
        "max": 18,
        "step": 1,
        "unit": "px",
        "label": "Base Body Size",
        "default": 16
      }
    ]
  },
  {
    "name": "Announcement Bar",
    "settings": [
      {
        "type": "checkbox",
        "id": "show_announcement",
        "label": "Show Announcement Bar",
        "default": true
      },
      {
        "type": "text",
        "id": "announcement_text",
        "label": "Announcement Text",
        "default": "COMPLIMENTARY INSURED WORLDWIDE EXPRESS SHIPPING • 5-YEAR INTERNATIONAL WARRANTY • 100% AUTHENTICITY CERTIFIED"
      },
      {
        "type": "url",
        "id": "announcement_link",
        "label": "Announcement Link"
      }
    ]
  },
  {
    "name": "Cart & Free Shipping",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Cart Type",
        "options": [
          { "value": "drawer", "label": "Slide-out Cart Drawer" },
          { "value": "page", "label": "Page" }
        ],
        "default": "drawer"
      },
      {
        "type": "number",
        "id": "free_shipping_threshold",
        "label": "Free Shipping Threshold (in store currency)",
        "default": 25000
      },
      {
        "type": "checkbox",
        "id": "show_cart_notes",
        "label": "Enable Cart Special Instructions Note",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_custom_engraving_option",
        "label": "Enable Complimentary Laser Engraving Option",
        "default": true
      }
    ]
  },
  {
    "name": "Social Media Links",
    "settings": [
      {
        "type": "text",
        "id": "social_instagram",
        "label": "Instagram URL",
        "default": "https://instagram.com"
      },
      {
        "type": "text",
        "id": "social_facebook",
        "label": "Facebook URL",
        "default": "https://facebook.com"
      },
      {
        "type": "text",
        "id": "social_youtube",
        "label": "YouTube URL",
        "default": "https://youtube.com"
      },
      {
        "type": "text",
        "id": "social_whatsapp",
        "label": "WhatsApp Concierge Link",
        "default": "https://wa.me/18005550199"
      }
    ]
  }
]
